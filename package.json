{
  "name": "mdtv-hots-overlay",
  "productName": "MDTV Overlay",
  "version": "1.1.0",
  "description": "Affiche un build Heroes of the Storm du serveur MDTV par-dessus le jeu.",
  "main": "main.js",
  "license": "MIT",
  "author": "MDTV",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "dev.pages.mdtv-hots.overlay",
    "files": ["main.js", "preload.js", "icone.png", "package.json"],
    "protocols": [{ "name": "MDTV Overlay", "schemes": ["mdtv-overlay"] }],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false, "shortcutName": "MDTV Overlay" }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  }
}
